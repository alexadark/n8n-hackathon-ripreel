{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    ".react-router/types/**/*",
    "**/*.ts",
    "**/*.tsx",
    "vite.config.ts",
    "react-router.config.ts"
  ],
  "exclude": ["node_modules", "ai_docs/**", "build/**", "ref/**"]
}
