# Development Environment Variables Template
# Copy this file to .env.local and fill in your values

# TEMP - Database password: [paste-generated-password-here] <------ ADD PASSWORD HERE TEMPORARILY.

# --- Database Configuration (Supabase - Drizzle ORM) ---
DATABASE_URL="your-database-url"

# --- Supabase Configuration ---
SUPABASE_URL="your-supabase-url"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- n8n Workflow Integration ---
# Webhook URLs discovered via n8n MCP during development
# Get these from your n8n workflow webhook triggers

# Split Screenplay Parsing (Bible + Scenes separately - avoids timeout)
# IMPORTANT: These must be set for proper workflow - fallback to break_script_into_scenes is deprecated
N8N_GENERATE_BIBLE_WEBHOOK="https://n8n.cutzai.com/webhook/generate-bible"
N8N_GENERATE_SCENES_WEBHOOK="https://n8n.cutzai.com/webhook/generate-scenes"

# Legacy combined workflow (deprecated - kept for backward compatibility)
N8N_PARSE_SCREENPLAY_WEBHOOK="https://n8n.cutzai.com/webhook/movie-script-breakdown"

# Video workflows
N8N_VIDEO_TRIMMING_WEBHOOK="https://n8n.cutzai.com/webhook/video-trimming"

# --- FFmpeg API Service ---
# Video processing service for trim, assembly, etc.
FFMPEG_API_URL="https://apps-ffmpeg-api.cd8kmo.easypanel.host"

# --- AI/LLM Configuration ---
OPENROUTER_API_KEY="your-openrouter-api-key"

# --- Development Settings ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
